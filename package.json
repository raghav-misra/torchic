{
  "name": "torchic",
  "version": "0.1.0",
  "description": "In-browser neural network library with reverse-mode autograd and three interchangeable compute backends: JS Web Workers, SIMD Rust/WebAssembly, and WebGPU.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/build-lib.mjs",
    "build:wasm": "cargo build --release --manifest-path crates/torchic-kernels/Cargo.toml && node scripts/copy-wasm.mjs",
    "prepublishOnly": "npm run build:wasm && npm run build:lib",
    "preview": "vite preview",
    "test": "vitest",
    "bench": "node scripts/bench.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "neural-network",
    "autograd",
    "tensor",
    "webgpu",
    "wasm",
    "webassembly",
    "simd",
    "sharedarraybuffer",
    "deep-learning",
    "machine-learning",
    "browser",
    "typescript"
  ],
  "author": "Raghav Misra <raghav.m2014@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghav-misra/torchic.git"
  },
  "bugs": {
    "url": "https://github.com/raghav-misra/torchic/issues"
  },
  "homepage": "https://github.com/raghav-misra/torchic#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "puppeteer": "^24.43.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.1",
    "vitest": "^1.0.0"
  }
}
